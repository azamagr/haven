{
  "info": {
    "name": "Haven API",
    "description": "Capstone API - auth, listings, bookings, dashboard.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "hostToken", "value": "" },
    { "key": "guestToken", "value": "" },
    { "key": "listingId", "value": "" }
  ],
  "item": [
    { "name": "Health check", "request": { "method": "GET", "url": "{{baseUrl}}/api/health" } },
    {
      "name": "Signup (host)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Host\",\n  \"email\": \"host@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"host\"\n}" },
        "url": "{{baseUrl}}/api/auth/signup"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"host@example.com\",\n  \"password\": \"password123\"\n}" },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    { "name": "Get listings (public)", "request": { "method": "GET", "url": "{{baseUrl}}/api/listings" } },
    {
      "name": "Create listing (host, needs a real file attached)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{hostToken}}" }],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "title", "value": "Test Cabin", "type": "text" },
            { "key": "description", "value": "A lovely cabin for testing purposes only.", "type": "text" },
            { "key": "location", "value": "Nathia Gali", "type": "text" },
            { "key": "category", "value": "Cabin", "type": "text" },
            { "key": "pricePerNight", "value": "80", "type": "text" },
            { "key": "maxGuests", "value": "4", "type": "text" },
            { "key": "photoAlt", "value": "A wooden cabin", "type": "text" },
            { "key": "photo", "type": "file", "src": [] }
          ]
        },
        "url": "{{baseUrl}}/api/listings"
      }
    },
    {
      "name": "Create listing as guest (blocked demo)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{guestToken}}" }],
        "body": { "mode": "formdata", "formdata": [{ "key": "title", "value": "Should fail", "type": "text" }] },
        "url": "{{baseUrl}}/api/listings"
      }
    },
    {
      "name": "Create booking",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{guestToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"checkIn\": \"2030-06-10\",\n  \"checkOut\": \"2030-06-13\",\n  \"guests\": 2\n}" },
        "url": "{{baseUrl}}/api/bookings"
      }
    },
    { "name": "Get my bookings", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{guestToken}}" }], "url": "{{baseUrl}}/api/bookings/mine" } },
    { "name": "Get host dashboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{hostToken}}" }], "url": "{{baseUrl}}/api/dashboard" } }
  ]
}
